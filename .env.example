# eSurvey platform configuration.
#
#   cp .env.example .env
#   ./scripts/gen-secrets.sh >> .env     # fills in the three generated values
#
# Everything marked GENERATE must be a fresh random value per deployment. A
# secret copied between environments means a token minted in staging is valid
# in production, and a compromise of the weaker one is a compromise of both.
#
# .env is git-ignored. Keep it that way.

# --- database ----------------------------------------------------------------
POSTGRES_USER=esurvey
POSTGRES_DB=esurvey
# GENERATE
POSTGRES_PASSWORD=
# Loopback, and off the standard port so this stack cannot collide with -- or
# worse, quietly attach to -- another Postgres on the same machine.
POSTGRES_PORT=55432
# PgBouncer, on loopback, for running the test suites through the pooler.
PGBOUNCER_PORT=56432

# The compose stack sets the four database URLs itself: requests and workers
# through PgBouncer, dashboard reads through PgBouncer to the replica, and
# migrations and the audit chain straight to the primary. Outside compose, set:
#
#   ESURVEY_DATABASE_URL         primary, or the pooler in front of it
#   ESURVEY_DATABASE_DIRECT_URL  primary, never pooled (required when pooled)
#   ESURVEY_DATABASE_READ_URL    read replica; empty reads from the primary
#   ESURVEY_DATABASE_POOLED      true behind a transaction pooler
#
# Pool sizes are per API instance. Behind PgBouncer they are client
# connections and cheap; without it every one is a Postgres backend, so keep
# instances x (api + worker + direct) under the server's max_connections.
ESURVEY_DB_MAX_CONNS=20
ESURVEY_DB_WORKER_MAX_CONNS=10
ESURVEY_DB_READ_MAX_CONNS=20
# Past this, dashboard reads go back to the primary until the replica catches up.
ESURVEY_DB_REPLICA_MAX_LAG=10s

# --- mail --------------------------------------------------------------------
#
# Officer invitations and password resets. Empty leaves mail off: the console
# shows an administrator the link to pass on by hand, which is a working
# deployment and not a broken one.
#
# Port 465 is implicit TLS -- set STARTTLS=false. Port 587 is plaintext
# upgraded by STARTTLS -- set it true. The wrong pair is the usual reason a
# relay refuses the password.
ESURVEY_SMTP_HOST=
ESURVEY_SMTP_PORT=465
ESURVEY_SMTP_USERNAME=
# GENERATE is wrong here: this is the mailbox password from the mail provider.
ESURVEY_SMTP_PASSWORD=
# The address officers see mail come from. Usually the username.
ESURVEY_SMTP_FROM=
ESURVEY_SMTP_STARTTLS=false

# Where an officer's browser reaches the console, for the links in that mail.
ESURVEY_CONSOLE_BASE_URL=http://127.0.0.1:3000

# --- redis -------------------------------------------------------------------
# GENERATE. Redis holds refresh tokens and one-time codes; it is not a cache
# whose contents are harmless.
REDIS_PASSWORD=
REDIS_PORT=56379
# Sessions, one-time codes and throttles -- not a cache. Sized from the
# expected number of farmers: roughly 400 B per live session plus 180 B per
# refresh in the last 72 hours. Redis refuses writes rather than evicting when
# full, and the API warns from 75%.
REDIS_MAXMEMORY=1gb

# --- token signing -----------------------------------------------------------
# GENERATE. Base64 of 32 random bytes -- an Ed25519 seed.
#
#   openssl rand -base64 32
#
# Rotation: move the current value into ESURVEY_JWT_PREVIOUS_SEEDS, put a new
# one here, and drop the old entry after one access-token lifetime (15 minutes
# by default). Nobody is signed out.
ESURVEY_JWT_SEED=
ESURVEY_JWT_PREVIOUS_SEEDS=

# --- service -----------------------------------------------------------------
# development | staging | production.
#
# staging and production are "hardened": the loader refuses to start without a
# signing key, without a Redis password, with one-time codes going to the log,
# or with a plaintext CORS origin. Those refusals are the point of the setting.
ESURVEY_ENV=development

API_PORT=8090
AI_PORT=8100
ESURVEY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How many reverse proxies you run in front of the API. The client address is
# read that many entries from the right of X-Forwarded-For; everything else in
# that header is written by the caller. 0 ignores it and uses the socket.
ESURVEY_TRUSTED_PROXY_HOPS=0

# --- first sign-in -----------------------------------------------------------
# Used only when the account roll is empty. The account it creates can do
# exactly one thing until its password is replaced: replace its password.
#
# The username is the administrator's email address: every officer signs in
# with their email, and the server refuses to start with anything else here.
#
# Delete both lines once that is done.
ESURVEY_BOOTSTRAP_ADMIN_USERNAME=
ESURVEY_BOOTSTRAP_ADMIN_PASSWORD=

# --- one-time codes ----------------------------------------------------------
# "log" writes farmer sign-in codes to the service log. Development only, and
# a hardened environment refuses to start with it.
ESURVEY_OTP_SENDER=log

# --- upstreams ---------------------------------------------------------------
SATELLITE_URL=http://34.93.99.56:8080
SATELLITE_API_KEY=

# The Gemini key is NOT here. It lives in ai-services/.env, which the agent
# reads directly and which compose passes through as an env_file -- one file to
# rotate rather than two copies to drift apart.
ESURVEY_AI_MODEL=gemini-3.1-pro-preview

# --- Evidence storage -------------------------------------------------------
# Farmer-captured photographs and video. The most sensitive thing this
# platform holds: images of identified people's land, tied to their name.
#
# Leave ESURVEY_EVIDENCE_BUCKET empty to keep evidence on the local volume
# (the development default). Set it to send evidence to Cloud Storage, and see
# docs/EVIDENCE_STORAGE.md for what the bucket must already enforce.
#
# There is no automatic fallback from a configured bucket to local disk:
# silently writing evidence somewhere other than where you believe it is going
# is worse than failing to start.
ESURVEY_EVIDENCE_DIR=../evidence
# Required in production: a season of station clips is terabytes, which a
# container volume cannot hold. Apply deploy/evidence-lifecycle.json to it.
ESURVEY_EVIDENCE_BUCKET=
ESURVEY_EVIDENCE_PREFIX=

# Authentication is Application Default Credentials and nothing else.
# Never a downloaded service-account key: a long-lived key to this bucket is
# the single worst secret this system could have.
#
# To switch the bucket on, in full:
#
#   1. gcloud auth application-default login
#   2. GOOGLE_ADC_FILE=$HOME/.config/gcloud/application_default_credentials.json
#   3. ESURVEY_EVIDENCE_BUCKET=esurvey-evidence-501512
#   4. docker compose up -d api
#
# GOOGLE_ADC_FILE is the host path compose mounts read-only into the
# container. Leave it unset on GKE or Cloud Run, where the workload's own
# identity is read from the metadata server and no file is involved.
#
# /readyz reports where evidence is going, and the server refuses to start if
# a named bucket is unreachable.
GOOGLE_ADC_FILE=

# --- how much work runs at once ---------------------------------------------
#
# Assessments are queued and produced by workers, not inside the request that
# asks for one. Workers per instance are not the limit on anything upstream --
# the gates below are -- so this only needs to be enough to keep every gate
# full. A worker waiting for a slot costs a goroutine and no connection.
ESURVEY_ASSESSMENT_WORKERS=24

# How many analyses every API instance TOGETHER may have running on each
# upstream, counted in Redis. Set each to that upstream's own quota, never
# per instance. See docs/ASSESSMENT_CAPACITY.md for how to size them.
#
#   SATELLITE  the Farm Analytics Engine's Earth Engine project concurrency
#   RADAR      radar service replicas x ESURVEY_SAR_MAX_CONCURRENT
#   AI         model provider quota / model calls one assessment makes at once
#   VISION     ground-vision service capacity
ESURVEY_GATE_SATELLITE=4
ESURVEY_GATE_RADAR=4
ESURVEY_GATE_AI=8
ESURVEY_GATE_VISION=4

# --- ground video ------------------------------------------------------------
#
# The survey walk is the specification's heaviest evidence: 0.50 of the damage
# figure in clear weather, 0.65 under cloud. The vision service decodes the
# clip and samples keyframes; the assessment service reads them, because that
# is where the model credential is kept.
#
# Empty turns the model path off. With it off and the baseline below also off,
# the platform assesses without a ground score and says the source was absent.
ESURVEY_VISION_AGENT_URL=http://ai:8100
# One model call over up to eight keyframes. Generous: waiting is better than
# an assessment with no ground evidence at all.
ESURVEY_VISION_AGENT_TIMEOUT=180

# The classical baseline that preceded the model: colour thresholds and a
# gradient orientation. It labels itself, and the platform refuses a labelled
# baseline outside development. Development only, and only when the model path
# is off.
ESURVEY_VISION_BASELINE=0

# Loops advancing claims (acknowledge, queue the assessment, allocate) in each
# instance. Each holds one database connection while it steps; keep it well
# under ESURVEY_DB_MAX_CONNS.
ESURVEY_PIPELINE_WORKERS=4

# Messages in flight to the SMS aggregator at once. The ceiling is contractual
# -- aggregators sell throughput per second and refuse above it.
ESURVEY_SMS_WORKERS=16

# The SMS gateway. Empty leaves SMS off: notifications queue, one-time codes
# fall back to the log sender, and nobody is told anything.
#
#   msg91       the v5 flow API; ESURVEY_SMS_AUTH_KEY is the authkey
#   enterprise  the /fe/api/v1/message gateway (username + password, JSON POST)
#   generic     any other aggregator, via a URL template
#
# For enterprise, ESURVEY_SMS_URL is the full message endpoint, e.g.
# https://<your-domain>/fe/api/v1/message, ESURVEY_SMS_USERNAME the API user
# and ESURVEY_SMS_AUTH_KEY that user's password. The JSON endpoint is used
# rather than the documented GET so the password travels in a header instead
# of in every proxy log between here and the aggregator.
ESURVEY_SMS_PROVIDER=
ESURVEY_SMS_URL=
ESURVEY_SMS_USERNAME=
ESURVEY_SMS_AUTH_KEY=

# The DLT-registered header, exactly six characters, e.g. ESURVY.
ESURVEY_SMS_SENDER_ID=

# event=dlt_template_id pairs. Not optional: an Indian operator drops any
# message with no registered template while the aggregator still answers 200,
# so a gateway without these delivers nothing and reports success. The
# one-time code is registered under auth.otp, and its approved template text
# has to match what internal/sms/adapters.go sends.
ESURVEY_SMS_TEMPLATES=

# Set ESURVEY_OTP_SENDER=sms once the above is real; it is refused at startup
# while no gateway is configured, so codes cannot silently stop arriving.

# How long a delivered notice is kept. Thirteen months: longer than any appeal
# against the season it belongs to. Undelivered ones are kept until dealt with.
ESURVEY_NOTIFICATION_RETENTION=9600h

# A farmer's access token. Longer than an officer's on purpose: every expiry is
# a refresh, and a refresh on 2G is a round trip a phone in a field may not
# complete. The refresh token remains the revocation point.
ESURVEY_FARMER_ACCESS_TTL=6h
