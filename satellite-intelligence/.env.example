# The GCP project registered for Earth Engine.
ESURVEY_SAR_EE_PROJECT=esurvey-501512

# Where Application Default Credentials are mounted inside the container.
# Deliberately ADC and not a service-account key: a downloaded key is a
# long-lived, silently copyable credential.
GOOGLE_APPLICATION_CREDENTIALS=/var/run/gcp/adc.json

# Plausible backscatter without Earth Engine, for developing the platform's
# side of the contract. Every result is labelled SYNTHETIC.
ESURVEY_SAR_SYNTHETIC=0

# How many Earth Engine requests may be in flight. EE limits concurrency per
# project, and a district-wide event submits hundreds of parcels in minutes.
ESURVEY_SAR_MAX_CONCURRENT=4

# Beyond this many queued tasks the service returns 503 with Retry-After
# rather than accepting work it cannot start.
ESURVEY_SAR_MAX_QUEUED=200
