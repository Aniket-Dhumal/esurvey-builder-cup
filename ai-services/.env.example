# Gemini credential — one of these paths is required.
ESURVEY_AI_GOOGLE_API_KEY=

# Or Vertex AI:
# ESURVEY_AI_USE_VERTEX=true
# ESURVEY_AI_VERTEX_PROJECT=third-party-services-bridges
# ESURVEY_AI_VERTEX_LOCATION=asia-south1

# Verify against the current model list before deploying.
ESURVEY_AI_MODEL=gemini-3.1-pro-preview

# Near-deterministic: this grades evidence for a relief decision.
ESURVEY_AI_TEMPERATURE=0.1

ESURVEY_AI_HOST=127.0.0.1
ESURVEY_AI_PORT=8100
ESURVEY_AI_MIN_OBSERVATIONS=2
